{
  "version": "1.0.0",
  "ontology_uri": "https://w3id.org/sos/eo-formats#",
  "description": "Mapping from SOS EO formats ontology identifiers to module-local identifiers",
  "mappings": {
    "COG": "cog",
    "DEM": "dem",
    "DSM": "dsm",
    "DTM": "dtm",
    "EsriJSON": "esrijson",
    "GeoJSON": "geojson",
    "GeoPackage": "geopackage",
    "GeoParquet": "geoparquet",
    "GeoTIFF": "geotiff",
    "GeoZarr": "geozarr",
    "GML": "gml",
    "GPX": "gpx",
    "GRIB": "grib",
    "KML": "kml",
    "NetCDF_CF": "netcdf",
    "OSM_JSON": "osm_json",
    "OSM_XML": "osm_xml",
    "PBF": "pbf",
    "Shapefile": "shapefile",
    "VRT": "vrt",
    "WKB": "wkb",
    "WKT": "wkt",
    "XDMF": "xdmf",
    "GIS": "gis_data",
    "Raster": "raster",
    "Vector": "vector"
  }
}
